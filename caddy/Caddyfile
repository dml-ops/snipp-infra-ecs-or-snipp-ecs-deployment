{$DOMAIN}, www.{$DOMAIN} {
    encode gzip

    handle /api/* {
        reverse_proxy backend:5000
    }

    @shortcode {
        path_regexp ^/[A-Za-z0-9_-]{4,10}$
    }
    handle @shortcode {
        reverse_proxy backend:5000
    }

    handle {
        root * /srv
        file_server
        try_files {path} /index.html
    }
}